#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules
#
.*
*.a
*.diff
*.elf
*.ELF
*.erl
*.exe
*.irx
*.map
*.o
*.patch
*.rej
*.s
*.zip
*.ZIP
*.d

#
# files that we don't want to ignore
#
!.gitignore
!.gitattributes
!.github
!.editorconfig
!.clang-format
!.clang-format-ignore
!modules/debug/*.irx
# assembler sources: Git on Windows ignores case, so *.s above would hide them
!*.S

#
# Generated source files
#
pc/*/bin/
IOPRP_img.c
asm/*.c

#
# 3rd party
#
*modules/network/lwNBD
*thirdparty/clang-format-lint-action

# language
lng/lang_*.lng
*lng_src
src/lang_internal.c
include/lang_autogen.h
tmp/
*modules/usb/usbd_mini/ps2sdk
*modules/mmce/mmceman
*modules/network/neutrino

# Documentation site built by zensical (docs/, mkdocs.yml)
/site/

# Patches that the download scripts apply to the fetched sources
!/modules/network/udpbd-info-retry.diff
