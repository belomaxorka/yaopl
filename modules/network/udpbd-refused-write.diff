diff --git a/iop/udpbd/src/udpbd.c b/iop/udpbd/src/udpbd.c
index 8d199b4..b17a915 100644
--- a/iop/udpbd/src/udpbd.c
+++ b/iop/udpbd/src/udpbd.c
@@ -279,6 +279,15 @@ static int udpbd_write(struct block_device *bd, uint64_t sector, const void *buf
         return count;
     }
 
+    // OPL: an answer with an error, not a timeout, means the server does not write here (a read-only image or
+    // folder of PS2-Servers). Report the sectors as written, as udpbd-vexfat and a read-only udpbd-server do for
+    // the writes they drop: FatFs keeps a sector it cannot write back and then fails every read of another
+    // sector, so the whole disk became unreadable. OPL finds the server read-only by reading back a test file.
+    if (g_errno == 0) {
+        M_DEBUG("%s(%d, %d): not written by the server\n", __func__, (uint32_t)sector, count);
+        return count;
+    }
+
     M_DEBUG("%s(%d, %d): ERROR\n", __func__, (uint32_t)sector, count);
     g_errno = 0;
     return -EIO;
